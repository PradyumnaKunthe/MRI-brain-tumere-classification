# ==============================================================================
# .dockerignore for Hugging Face Spaces & Production Containers
# ==============================================================================

# Git and Version Control
.git
.gitignore
.gitattributes

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.venv*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo

# Full Raw Dataset (Exclude full training set to keep image under HF Spaces limit)
# Note: Sample test scans in dataset/.../Test are bundled for live UI sample evaluation
dataset/Epic and CSCR hospital Dataset/Train/

# Large offline training feature cache files (>27MB each, not required for live inference)
outputs/mobilenet_features/*.npz

# Local task & log files
*.log
scratch/

# Node.js artifacts (compiled freshly in Docker Stage 1)
node_modules/
frontend/node_modules/
