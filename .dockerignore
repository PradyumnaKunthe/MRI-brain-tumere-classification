# ==============================================================================
# .dockerignore for Google Cloud Run & Production Docker Builds
# ==============================================================================

# Git and Version Control
.git/
.gitignore
.gitattributes
.gcloudignore

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.venv*/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Dataset (Excluded from Cloud Run production container)
dataset/

# Offline training feature cache files (>27MB each, not required for live inference)
outputs/mobilenet_features/

# Local task & log files
*.log
scratch/
.system_generated/
.streamlit/

# Node.js artifacts (compiled fresh in Docker Stage 1)
node_modules/
frontend/node_modules/
frontend/dist/
